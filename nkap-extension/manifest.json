{
  "manifest_version": 3,
  "name": "nkapmobile — accessibilité linguistique",
  "version": "0.2.0",
  "description": "Le prof au tableau : traduit l'interface financière en douala (lexique verrouillé, montants intacts) et annote l'écran à la main.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://safinum.cm/*",
    "http://13.60.36.139/*",
    "https://*.sslip.io/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["fixtures/*.json", "fonts/*.ttf", "voice-bank/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/rules.js",
        "src/hand-geometry.js",
        "src/overlay.js",
        "src/lexicon.js",
        "src/assistant.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "src/background.js" }
}
