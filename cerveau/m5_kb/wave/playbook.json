  "screen_guides": {
    "home": {
      "llm_summary": "Accueil Wave : solde tout en haut, QR code au milieu, 4 boutons (Send, Bills, Vault, More) et historique des dernières transactions en bas.",
      "spoken": "Tu es sur l'accueil de Wave. En haut s'affiche ton solde, au milieu ton QR code pour recevoir ou payer, puis les boutons Envoyer, Factures, Coffre et Plus.",
      "highlights": [
        {
          "match": [
            "send",
            "envoyer"
          ],
          "style": "num",
          "step": 1,
          "label": "Envoyer",
          "color": "yellow"
        },
        {
          "match": [
            "bills",
            "factures"
          ],
          "style": "num",
          "step": 2,
          "label": "Factures",
          "color": "yellow"
        }
      ]
    },
    "send_money": {
      "llm_summary": "Écran Send Money (déjà ouvert) : l'utilisateur choisit un destinataire dans Contacts, tape dans le champ To, appuie sur Enter a new number (nouveau numéro) ou Scan to send (scanner QR).",
      "spoken": "Tu es sur l'écran d'envoi d'argent Wave. Tu as trois choix : appuie sur « Enter a new number » pour taper un nouveau numéro, sur « Scan to send » pour scanner le QR code de la personne, ou choisis directement un nom dans ta liste Contacts en dessous.",
      "highlights": [
        {
          "match": [
            "enter a new number",
            "saisir un nouveau numero"
          ],
          "style": "num",
          "step": 1,
          "label": "Nouveau n°",
          "color": "yellow"
        },
        {
          "match": [
            "scan to send",
            "scanner pour envoyer"
          ],
          "style": "num",
          "step": 2,
          "label": "Scanner QR",
          "color": "yellow"
        },
        {
          "match": [
            "contacts"
          ],
          "style": "highlight",
          "color": "yellow"
        }
      ]
    },
    "send_new_number": {
      "llm_summary": "Écran nouveau destinataire Wave : l'utilisateur saisit le nom complet et le numéro de téléphone du bénéficiaire, puis appuie sur Next / Suivant.",
      "spoken": "Ici tu ajoutes un nouveau destinataire : renseigne son nom et son numéro de téléphone en vérifiant bien chaque chiffre, puis appuie sur Suivant.",
      "highlights": [
        {
          "match": [
            "full name",
            "nom complet"
          ],
          "style": "num",
          "step": 1,
          "label": "Nom",
          "color": "yellow"
        },
        {
          "match": [
            "next",
            "suivant"
          ],
          "style": "frame",
          "label": "Suivant",
          "color": "yellow"
        }
      ]
    },
    "send_amount": {
      "llm_summary": "Écran saisie du montant Wave : Send Amount (montant débité), Receive Amount (montant net reçu) et petits frais Wave affichés avant d'appuyer sur Send.",
      "spoken": "Ici tu choisis la somme à envoyer : tape le montant dans Send Amount, vérifie bien le montant reçu et les frais affichés, puis appuie sur le bouton Envoyer en bas pour valider.",
      "highlights": [
        {
          "match": [
            "send amount",
            "montant envoye",
            "montant a envoyer"
          ],
          "style": "num",
          "step": 1,
          "label": "Montant",
          "color": "yellow"
        },
        {
          "match": [
            "receive amount",
            "montant recu"
          ],
          "style": "highlight",
          "color": "yellow"
        }
      ]
    },
    "card_qr": {
      "llm_summary": "QR code Wave plein écran : à montrer à un agent Wave pour un dépôt/retrait ou à un proche/marchand pour recevoir de l'argent.",
      "spoken": "Ton QR code Wave est affiché en grand : montre-le à l'agent Wave pour faire un dépôt ou un retrait, ou à un proche pour recevoir de l'argent. Appuie sur la flèche en haut à gauche pour revenir à l'accueil.",
      "highlights": []
    },
    "bills": {
      "llm_summary": "Écran Factures (Bills) Wave : recherche et sélection du fournisseur (électricité ENEO, eau CAMWATER, TV Canal+, internet) pour payer une facture.",
      "spoken": "Tu es sur l'écran Factures de Wave. Choisis ton fournisseur dans la liste ou cherche son nom en haut, puis entre ta référence client et le montant à payer.",
      "highlights": []
    },
    "vault": {
      "llm_summary": "Écran Coffre (Vault) Wave : espace d'épargne séparé du solde principal pour mettre de l'argent de côté ou le retirer.",
      "spoken": "Tu es dans ton Coffre d'épargne Wave. Tu peux y transférer de l'argent depuis ton solde principal pour le garder de côté, ou le retirer quand tu en as besoin.",
      "highlights": []
    },
    "more": {
      "llm_summary": "Écran Plus (More) Wave : services complémentaires (crédit téléphonique Airtime, banque, récompenses, transport).",
      "spoken": "Tu es dans le menu Plus de Wave : tu y retrouves les services complémentaires comme l'achat de crédit téléphonique, les transferts bancaires et d'autres paiements.",
      "highlights": []
    },
    "settings": {
      "llm_summary": "Écran Paramètres (Settings) Wave : changement du code secret, plafonds du compte, support client, agents à proximité et déconnexion.",
      "spoken": "Tu es dans les paramètres Wave : tu peux y vérifier tes plafonds, trouver des agents proches, contacter le support client ou modifier ton code secret.",
      "highlights": []
    }
  },
