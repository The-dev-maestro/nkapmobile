    "kele obusu": "Continuer",
    "ala oboso": "Continuer",
    "yemban": "Confirmer",
    "bamse": "Confirmer",
    "tyende": "Modifier",
    "tukwa": "Modifier",
    "bulan": "Retour",
    "timba": "Retour",
    "wog": "Écouter",
    "senga": "Écouter",
    "kui": "Déconnexion",
    "busa": "Déconnexion"
  },
  "action_buttons": [
    "envoyer de l'argent", "payer une facture", "acheter du credit", "mes operations",
    "continuer", "annuler", "confirmer", "modifier", "retour", "ecouter", "termine",
    "lomo moni", "loma moni", "yaan mfie ai kalara", "sawedi kalati", "kus kredi telefon",
    "ande kredi telefone", "itang mvet yam", "bebolo bam",
    "kele obusu", "ala oboso", "yemban", "bamse", "tyende", "tukwa", "vaa", "buka",
    "bulan", "timba", "wog", "senga", "facture", "credit", "kalara", "kalati", "kredi"
  ],
  "screen_detectors": [
    {
      "screen": "receipt",
      "url_any": ["/receipt"],
      "text_any": [
        "operation reussie", "mvet o boban mben", "ebolo e tilabe na bwam", "transaction successful",
        "nouveau solde", "itan mfefe", "moni ma pene ma dia",
        "mvet o vaban. te ke", "ebolo e bukabe. to moni", "operation annulee. aucun montant"
      ]
    },
    {
      "screen": "review",
      "url_any": ["/review", "/recap"],
      "text_any": [
        "verifiez avant de confirmer", "fombo ossussua eneu wa yemban", "ombwa oboso ba bamse",
        "check before you confirm", "l'argent part des que vous confirmez",
        "moni a ke di a te wa yemban", "moni ma ma-ala dibokimene"
      ]
    },
    {
      "screen": "transfer",
      "url_any": ["/transfer"],
      "text_any": [
        "mes beneficiaires", "bot bam ba non moni", "bakusa bam", "my beneficiaries",
        "nombo telefon nge dzoe", "nimero a telefone nga dina",
        "jusqu'a 500 000", "akui 500 000", "tinga 500 000", "up to 500 000"
      ]
    },
    {
      "screen": "pay_airtime",
      "text_any": [
        "numero a recharger", "nombo ya lomo kredi", "nimero ya kredi", "number to top up",
        "operateur detecte", "nsaa a yenban", "singi e yenbe",
        "nombo woe nge mod mfe", "nimero ango nga moto mpepe"
      ]
    },
    {
      "screen": "pay_bill",
      "text_any": ["choisir le service", "tob isae", "pona ebolo", "choose the service"]
    },
    {
      "screen": "pay",
      "url_any": ["/pay"],
      "text_all_groups": [
        ["facture", "credit"],
        ["kalara", "kredi"],
        ["kalati", "kredi"],
        ["bills", "airtime"]
      ],
      "not_text_any": ["solde disponible", "itan ineu", "moni ma pene", "available balance"]
    },
    {
      "screen": "history",
      "url_any": ["/history"],
      "text_any": ["historique des operations"],
      "text_all_groups": [
        ["recus", "envoyes"],
        ["bi bi", "bi lom"],
        ["ma-poy", "ma-ala"],
        ["incoming", "outgoing"]
      ],
      "not_text_any": ["solde disponible", "itan ineu", "moni ma pene", "available balance"]
    },
    {
      "screen": "home",
      "url_any": ["/home"],
      "text_any": [
        "solde disponible", "itan ineu", "moni ma pene", "available balance",
        "que voulez-vous faire", "za dzam wa yi bo", "nje o tondi bola"
      ]
    }
  ],
  "screen_guides": {
    "home": {
      "llm_summary": "Accueil Banque Démo SAFINUM : solde disponible en haut, 4 actions rapides (Envoyer de l'argent, Payer une facture, Acheter du crédit, Mes opérations) et dernières opérations en bas.",
      "spoken": "Tu es sur ton accueil bancaire. En haut tu vois ton solde disponible, au milieu les boutons pour envoyer de l'argent, payer une facture ou acheter du crédit, et en bas tes dernières opérations.",
      "highlights": [
        {"match": ["envoyer de l'argent", "lomo moni", "loma moni", "send money"], "style": "frame", "label": "Envoyer", "color": "yellow"}
      ]
    },
    "transfer": {
      "llm_summary": "Écran Transfert SAFINUM (déjà ouvert) : champ Bénéficiaire (ou liste Mes bénéficiaires à droite), champ Montant (l'indice en dessous est juste le plafond), boutons Annuler et Continuer.",
      "spoken": "Ici tu prépares un transfert : commence par choisir un bénéficiaire dans la liste ou tape son numéro, saisis ensuite le montant à envoyer, puis appuie sur Continuer.",
      "highlights": [
        {"match": ["beneficiaire", "mod a non moni", "mukusa", "beneficiary"], "style": "num", "step": 1, "label": "Bénéficiaire", "color": "yellow"},
        {"match": ["montant", "itan", "moni", "amount"], "style": "num", "step": 2, "label": "Montant", "color": "yellow"},
        {"match": ["continuer", "kele obusu", "ala oboso", "continue"], "style": "frame", "label": "Continuer", "color": "red"}
      ]
    },
    "pay_bill": {
      "llm_summary": "Écran Payer une facture SAFINUM (déjà ouvert) : choisir le fournisseur (ENEO, CAMWATER, CANAL, CAMTEL), entrer le montant et appuyer sur Continuer.",
      "spoken": "Tu es sur l'écran Paiement de facture : choisis d'abord le fournisseur (ENEO, CAMWATER, CANAL ou CAMTEL), entre ensuite le montant à payer, puis appuie sur Continuer.",
      "highlights": [
        {"match": ["choisir le service", "tob isae", "pona ebolo", "choose the service"], "style": "num", "step": 1, "label": "Fournisseur", "color": "yellow"},
        {"match": ["montant", "itan", "moni", "amount"], "style": "num", "step": 2, "label": "Montant", "color": "yellow"},
        {"match": ["continuer", "kele obusu", "ala oboso", "continue"], "style": "frame", "label": "Continuer", "color": "red"}
      ]
    },
    "pay_airtime": {
      "llm_summary": "Écran Achat de crédit téléphonique SAFINUM (déjà ouvert) : numéro à recharger, opérateur détecté, montant et bouton Continuer.",
      "spoken": "Tu es sur l'écran Crédit téléphonique : tape d'abord le numéro à recharger, vérifie l'opérateur et entre le montant, puis appuie sur Continuer.",
      "highlights": [
        {"match": ["numero a recharger", "nombo ya lomo kredi", "nimero ya kredi", "number to top up"], "style": "num", "step": 1, "label": "Numéro", "color": "yellow"},
        {"match": ["montant", "itan", "moni", "amount"], "style": "num", "step": 2, "label": "Montant", "color": "yellow"},
        {"match": ["continuer", "kele obusu", "ala oboso", "continue"], "style": "frame", "label": "Continuer", "color": "red"}
      ]
    },
    "pay": {
      "llm_summary": "Écran Payer SAFINUM : onglets Facture (ENEO/CAMWATER/CANAL/CAMTEL) et Crédit téléphonique, puis Continuer.",
      "spoken": "Ici tu paies une facture ou achètes du crédit : choisis l'onglet Facture ou Crédit, sélectionne le fournisseur ou le numéro, entre le montant puis appuie sur Continuer.",
      "highlights": [
        {"match": ["continuer", "kele obusu", "ala oboso", "continue"], "style": "frame", "label": "Continuer", "color": "red"}
      ]
    },
    "review": {
      "llm_summary": "Écran Récapitulatif avant validation SAFINUM : Bénéficiaire/Service, Montant, Frais, Total à débiter, Solde après opération ; boutons Confirmer, Modifier, Annuler.",
      "spoken": "Tu es sur le récapitulatif avant validation : vérifie bien le bénéficiaire, le montant, les frais et ton solde après opération, puis appuie sur Confirmer si tout est exact.",
      "highlights": [
        {"match": ["confirmer", "yemban", "bamse", "confirm"], "style": "frame", "label": "Confirmer", "color": "red"}
      ]
    },
    "recap": {
      "llm_summary": "Écran Récapitulatif avant validation SAFINUM : vérifier bénéficiaire, montant, frais et solde après opération avant Confirmer.",
      "spoken": "Tu es sur le récapitulatif avant validation : vérifie bien le bénéficiaire, le montant, les frais et ton solde après opération, puis appuie sur Confirmer si tout est exact.",
      "highlights": [
        {"match": ["confirmer", "yemban", "bamse", "confirm"], "style": "frame", "label": "Confirmer", "color": "red"}
      ]
    },
    "receipt": {
      "llm_summary": "Écran Reçu / Confirmation SAFINUM : opération enregistrée (ou annulée), numéro de référence et nouveau solde.",
      "spoken": "Ton opération est terminée : vérifie ton nouveau solde et garde le numéro de référence comme preuve en cas de besoin.",
      "highlights": [
        {"match": ["reference", "nombo ndem", "edun"], "style": "highlight", "color": "green"}
      ]
    },
    "history": {
      "llm_summary": "Écran Historique SAFINUM : filtres Tout / Reçus / Envoyés et tableau Date, Opération, Statut (Confirmé, En attente, Annulé, Échoué), Montant.",
      "spoken": "Ici tu consultes toutes tes opérations passées : utilise les boutons Tout, Reçus ou Envoyés pour filtrer et vérifier si chaque paiement est confirmé ou annulé.",
      "highlights": [
        {"match": ["recus", "bi bi", "ma-poy", "incoming"], "style": "num", "step": 1, "label": "Reçus", "color": "yellow"},
        {"match": ["envoyes", "bi lom", "ma-ala", "outgoing"], "style": "num", "step": 2, "label": "Envoyés", "color": "yellow"}
      ]
    }
  },
